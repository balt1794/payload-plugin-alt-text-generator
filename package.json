{
  "name": "@balt1794/payload-plugin-alt-text-generator",
  "version": "1.0.0",
  "description": "Generate SEO-friendly alt text for the images in your Payload CMS media library: one at a time, in bulk, or automatically on upload.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run copyfiles && npm run build:types && npm run build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --ignore \"**/__tests__/**\"",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload generate:importmap",
    "dev:generate-types": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload generate:types",
    "lint": "eslint ./src",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@swc/core": "^1.16.20",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.3",
    "graphql": "^16.8.1",
    "mongodb-memory-server": "10.1.4",
    "next": "16.3.3",
    "open": "^10.1.0",
    "payload": "3.92.1",
    "prettier": "^3.4.2",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sharp": "0.35.4",
    "sort-package-json": "^2.10.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@payloadcms/next": "^3.92.0",
    "@payloadcms/ui": "^3.92.0",
    "payload": "^3.92.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "Bryam Loaiza <balt1794@gmail.com>",
  "homepage": "https://github.com/balt1794/payload-plugin-alt-text-generator#readme",
  "bugs": {
    "url": "https://github.com/balt1794/payload-plugin-alt-text-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balt1794/payload-plugin-alt-text-generator.git"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "alt-text",
    "accessibility",
    "seo",
    "ai",
    "images",
    "media"
  ],
  "publishConfig": {
    "access": "public"
  }
}
